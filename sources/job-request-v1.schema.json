      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "wallet.add"
        },
        "input": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "address",
            "tag"
          ],
          "additionalProperties": false
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        }
      },
      "required": [
        "schema_version",
        "operation",
        "input",
        "idempotency_key"
      ],
      "additionalProperties": false
    },
    {
