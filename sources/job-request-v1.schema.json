                    "type": "integer",
                    "minimum": 1
                  },
                  "url_env": {
                    "type": "string",
                    "pattern": "^[A-Z_][A-Z0-9_]{0,99}$"
                  }
                },
                "required": [
                  "chain_id",
                  "url_env"
                ],
                "additionalProperties": false
              },
              "maxItems": 30
            },
            "allow_public_fallback": {
              "type": "boolean"
            },
